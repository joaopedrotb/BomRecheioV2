{
  "name": "bom-recheio-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev dist --port 8788",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "seed:local": "node scripts/seed.mjs && wrangler d1 execute DB --local --file scripts/seed.sql",
    "seed:remote": "node scripts/seed.mjs && wrangler d1 execute DB --remote --file scripts/seed.sql"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0",
    "wrangler": "^4.135.0"
  }
}
